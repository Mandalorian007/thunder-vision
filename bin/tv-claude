#!/bin/sh
# Claude Code, headless, for workflow steps: tv-claude "prompt" [claude flags].
# The prompt can also come on stdin. Runs in auto mode and streams JSON, which
# the workflow runner turns into a readable log and remembers the session of
# (for "Continue in session"). Outside a workflow, the output is raw JSON.
exec "${TV_CLAUDE_BIN:-claude}" -p --permission-mode auto \
  --output-format stream-json --verbose "$@"
