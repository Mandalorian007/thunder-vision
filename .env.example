# Thunder Vision settings. Copy to .env and edit; every line is optional.
# Variables set in the environment win over this file. The server reads it at
# startup (pnpm dev restarts on save), and scripts/install-launchd.sh reads it
# too.

# Folder the new-session palette lists (two levels deep). Relative names typed
# in the palette, new folders and clones land here.
# TV_ROOT=~/repos

# Port to listen on. It always listens on 127.0.0.1 only: the server has no
# login of its own, so tailscale serve is the way in (see README, Security).
# PORT=7700

# Only these Tailscale logins get in (comma-separated), e.g.
# you@github,partner@example.com. Unset: anyone on your tailnet. List the
# logins on your tailnet with: tailscale status --json | jq -r '.User[].LoginName'
# Only trustworthy behind tailscale serve, which sets the login header; any
# other process on this machine can forge it.
# TV_ALLOWED_LOGINS=

# Binaries, for when PATH is minimal (launchd). The install script uses the
# tmux on PATH unless TMUX_BIN is set. CLAUDE_BIN defaults to the copy bundled
# with the Agent SDK.
# TMUX_BIN=/opt/homebrew/bin/tmux
# CLAUDE_BIN=/Users/you/.local/bin/claude

# launchd label for scripts/install-launchd.sh. Rerun the script after
# changing it.
# TV_LAUNCHD_LABEL=local.thunder-vision
